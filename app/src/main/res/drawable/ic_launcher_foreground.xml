<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground — 108×108dp canvas.
    Safe zone: 18dp inset on all sides (inner 72×72dp).
    All elements sit well within the safe zone.

    Design: minimal speaker body (rect) + cone (trapezoid) + two arc waves.
    Cone tip is at (54, 54) — centred on the canvas.
    Wave arcs: both centred on the cone tip, spanning ±45°.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Speaker body (rectangular box) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M24,44 L36,44 L36,64 L24,64 Z" />

    <!-- Speaker cone (trapezoid flaring right, tip centred at 54,54) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36,44 L54,34 L54,74 L36,64 Z" />

    <!-- Sound wave — small (r=10, centre 54,54, arc ±45°) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M61,47 A10,10 0,0,1 61,61" />

    <!-- Sound wave — large (r=18, centre 54,54, arc ±45°) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M67,41 A18,18 0,0,1 67,67" />

</vector>